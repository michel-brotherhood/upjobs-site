# Cloudflare Pages — cabeçalhos HTTP
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  # CSP em modo somente-relatório: NÃO bloqueia nada, apenas reporta violações.
  # Depois de validar no console, troque por "Content-Security-Policy" (ver README/deploy).
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; form-action 'self'; frame-ancestors 'self'

# Fontes: imutáveis (nome de arquivo estável) — cache longo
/public/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Imagens e favicon — cache médio
/public/images/*
  Cache-Control: public, max-age=2592000
/public/og/*
  Cache-Control: public, max-age=2592000
/public/favicon/*
  Cache-Control: public, max-age=2592000

# CSS de produção — cache curto (não é versionado por hash)
/dist/*
  Cache-Control: public, max-age=86400

# Dados dos cursos — cache curto para refletir atualizações rápido
/src/data/*
  Cache-Control: public, max-age=3600

# HTML — sempre revalidar
/*.html
  Cache-Control: public, max-age=0, must-revalidate
