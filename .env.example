# Upjobs — variáveis de ambiente (exemplo)
# Este site é estático (sem backend nesta fase). As variáveis abaixo são
# referências para futura integração e para facilitar a configuração.
#
# Não coloque segredos reais neste arquivo. Copie para ".env" localmente.

# WhatsApp de vendas (somente dígitos, com DDI). Usado nos CTAs.
UPJOBS_WHATSAPP=5521999389009

# Telefone de vendas
UPJOBS_PHONE=552120420068

# E-mails de contato
UPJOBS_EMAIL_CONTATO=contato@upjobscursos.com.br
UPJOBS_EMAIL_SECRETARIA=secretaria@upjobscursos.com.br

# Link oficial do Grupo VIP no WhatsApp (a definir)
UPJOBS_VIP_GROUP_URL=

# (Futuro) Endpoint de formulário via serviço externo (ex.: Formspree)
UPJOBS_FORM_ENDPOINT=
