# Exemplo de configuração Nginx para a VPS (site estático Upjobs).
# Ajuste server_name, caminhos e certificados. Depois: nginx -t && systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name upjobscursos.com.br www.upjobscursos.com.br;
    # Redireciona todo HTTP para HTTPS
    return 301 https://www.upjobscursos.com.br$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name upjobscursos.com.br;
    # Padroniza no "www" (consistente com canonical/og das páginas)
    ssl_certificate     /etc/letsencrypt/live/upjobscursos.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/upjobscursos.com.br/privkey.pem;
    return 301 https://www.upjobscursos.com.br$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.upjobscursos.com.br;

    root /var/www/upjobs-site;   # onde o repositório foi publicado
    index index.html;

    ssl_certificate     /etc/letsencrypt/live/upjobscursos.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/upjobscursos.com.br/privkey.pem;

    # --- Compressão ---
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;
    gzip_min_length 1024;
    # Se tiver o módulo brotli, habilite também:
    # brotli on;
    # brotli_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    # --- MIME extras (o Nginx padrão pode não trazer) ---
    types { application/manifest+json webmanifest; font/woff2 woff2; }

    # --- Cabeçalhos de segurança ---
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    # HSTS só depois de confirmar que o HTTPS está 100% ok:
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # --- Cache de assets ---
    location /public/fonts/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
    location ~* ^/public/(images|og|favicon)/ { add_header Cache-Control "public, max-age=2592000"; }
    location /dist/ { add_header Cache-Control "public, max-age=86400"; }
    location = / { add_header Cache-Control "public, max-age=0, must-revalidate"; }

    # Página de erro personalizada
    error_page 404 /404.html;

    # Serve arquivos estáticos; tenta .html implícito e cai no 404 do site
    location / {
        try_files $uri $uri.html $uri/ =404;
    }
}
